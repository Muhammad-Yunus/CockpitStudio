# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Connection (Drizzle ORM)
PGHOST="aws-0-ap-south-1.pooler.supabase.com"
PGPORT="5432"
PGDATABASE="postgres"
PGUSER="YOUR_PG_USER"
PGPASSWORD="YOUR_PG_PASSWORD"
PGSSL="true"

# Authentication JWT signing secret
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
